@using Microsoft.AspNetCore.Identity
@inject SignInManager<Usuario> signInManager

<ul class="navbar-nav">
    @if (signInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="navbar-brand">Hola, @User.Identity.Name</span>
        </li>
        <li class="nav-item">
            <form class="form-inline" asp-action="logout" asp-controller="usuarios">
                <button type="submit" class="navbar-brand btn btn-link ">
                    Logout
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="navbar-brand">
            <a class="nav-pills nav-link" asp-controller="usuarios" asp-action="Registro">
                Registro
            </a>
        </li>
        <li class="navbar-brand">
            <a class="nav-pills nav-link" asp-controller="usuarios" asp-action="Login">
                Login
            </a>
        </li>
    }
</ul>